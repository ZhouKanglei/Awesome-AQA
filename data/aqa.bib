  modality = {RGB, Text},
  project  = {},
  tags     = {Vision-Language, Collaboration Learning, Knowledge Distillation, Contrastive Learning},
  comment  = {This paper proposes VLC-Net for AQA by bidirectional knowledge distillation between vision-language pretrained knowledge and visual action knowledge, vision-language alignment guidance, and multimodal contrastive learning, showing improved performance on FineDiving, MTL-AQA, FineFS, and Fis-V.}
}

@article{wang2026taichi,
  title    = {TaiChi-AQA: A Dataset and Framework for Action Quality Assessment and Visual Analysis},
  author   = {Wang, Dejin and Lin, Fengyan and Zhu, Kexin and Chen, Zhide},
  journal  = IETCV,
  volume   = {20},
  number   = {1},
  pages    = {e70053},
  year     = {2026},
  code  = {https://github.com/mlxger/TaiChi-AQA},
  modality = {RGB},
  domain   = {Sports},
  tags     = {Dataset, TaiChi-AQA (new)},
  pdf      = {https://ietresearch.onlinelibrary.wiley.com/doi/full/10.1049/cvi2.70053},
  comment  = {This paper builds a new TaiChi-AQA dataset of 1,313 Tai Chi videos with detailed scoring and fine-grained labels (action labels, descriptions, frame-level perspectives). The paper evaluates existing AQA methods on this dataset and proposes a lightweight module (multi-head attention + gMLP) integrated into a distributed autoencoder (DAE). Experiments show the proposed method achieves state-of-the-art results on TaiChi-AQA.}
}

@article{tao2026libs,
