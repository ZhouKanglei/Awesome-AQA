  tags      = {Contrastive AQA, Multi-Stage Modeling},
  comment   = {This work proposes MCoRe, a multi-stage contrastive regression framework for AQA that segments an action video into multiple stages/procedures to capture stage-level characteristics while reducing computation. It introduces a stage-wise contrastive regression loss (inspired by graph contrastive learning) to align features from the same stage across samples and better separate different stages/qualities, improving score regression. It reported state-of-the-art performance on FineDiving at the time; later extended by HP-MCoRe \cite{qi2025action} with pose-guided hierarchical modeling.}
}

@article{zeng2024multimodal,
  author   = {Zeng, Ling-An and Zheng, Wei-Shi},
  title    = {Multimodal Action Quality Assessment},
  journal  = TIP,
  year     = {2024},
  volume   = {33},
  pages    = {1600--1613},
  pdf      = {https://arxiv.org/pdf/2402.09444},
  domain   = {Sports},
  modality = {RGB, Optical Flow, Audio},
  code  = {https://github.com/qinghuannn/PAMFN},
  tags     = {Multi-Modal AQA, Audio-Visual, Fusion},
  comment  = {This work proposes PAMFN (Progressive Adaptive Multimodal Fusion Network) for multimodal AQA using RGB, optical flow, and audio. PAMFN decouples modality-specific modeling (three separate branches) from mixed-modality modeling (a progressive aggregation branch), and introduces (i) a modality-specific feature decoder to selectively transfer unimodal cues, (ii) an adaptive fusion module (FusionNets + PolicyNet) to learn part-dependent fusion policies, and (iii) a cross-modal feature decoder to inject fused cross-modal representations; achieves SOTA on public AQA datasets, with notable gains on music-related sports (e.g., figure skating, rhythmic gymnastics).}
}

@inproceedings{zhang2024narrative,
  author    = {Zhang, Shiyi and Bai, Sule and Chen, Guangyi and Chen, Lei and Lu, Jiwen and Wang, Junle and Tang, Yansong},
  title     = {Narrative Action Evaluation with Prompt-Guided Multimodal Interaction},
  booktitle = CVPR,
  year      = {2024},
  pages     = {18430--18439},
  pdf       = {https://arxiv.org/pdf/2404.14471},
  domain    = {Sports},
  modality  = {RGB, Text},
  code   = {https://github.com/shiyi-zh0408/NAE_CVPR2024},
  tags      = {Multi-Modal AQA, Narrative Action Evaluation, Video Captioning, Dataset, MTL-AQA (re-annotated), FineGym (re-annotated)},
  comment   = {This work introduces Narrative Action Evaluation (NAE), which generates professional, score-aware commentary that balances evaluative rigor (e.g., scores/actions/qualitative judgments) with rich natural language. It proposes a prompt-guided multimodal interaction framework that (i) injects score information into learnable prompts via context-aware prompt learning, (ii) reformulates score regression as a video-text matching problem to encourage task interactivity, and (iii) uses a tri-token attention mask to emphasize evaluation and video cues during decoding. It also re-annotates MTL-AQA and FineGym with comprehensive narrative evaluations and releases data/code.}
}

@inproceedings{dadashzadeh2024pecop,
