@article{dong2026uila,
  author   = {Dong, Xu and Liu, Xinran and Li, Wanqing and Adeyemi-Ejeye, Anthony and Gilbert, Andrew},
  title    = {UIL-AQA: Uncertainty-Aware Clip-Level Interpretable Action Quality Assessment},
  journal  = IJCV,
  year     = {2026},
  volume   = {134},
  number   = {24},
  pages    = {},
  pdf      = {https://www.researchgate.net/publication/399128456_UIL-AQA_Uncertainty-Aware_Clip-Level_Interpretable_Action_Quality_Assessment_UIL-AQA_Uncertainty-Aware_Clip-Level_InterpretableX_Dong_et_al},
