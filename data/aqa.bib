@article{liu2026tfbf,
  author   = {Liu, Tengfei and Hu, Ruimin and Tian, Ye and Cheng, Min and Zheng, Qi and Liao, Liang},
  title    = {TFBF: Temporal-Frequency Bidirectional Fusion for Action Quality Assessment},
  journal  = TMM,
  year     = {2026},
  pages    = {1--13},
  doi      = {10.1109/TMM.2026.3712209},
  pdf      = {https://ieeexplore.ieee.org/stamp/stamp.jsp?tp=&arnumber=11603291},
  domain   = {Sports, Medical Rehabilitation},
  modality = {RGB},
  project  = {},
  tags     = {Temporal-Frequency Fusion, Frequency-Domain AQA, Discrete Wavelet Transform, Plug-and-Play Module},
  comment  = {This work introduces frequency-domain features into AQA through a 3D discrete wavelet feature extractor and proposes TFBF to bidirectionally fuse temporal- and frequency-domain representations. Experiments on FineDiving, AQA-7, FineDiving-HM, MTL-AQA, and JIGSAWS demonstrate strong performance, while the proposed 3DWFE and BFA modules can also serve as plug-and-play components for existing AQA methods.}
}

@article{zhou2026dualalign,
  author   = {Zhou, Kanglei and Cai, Ruizhi and Wang, Xinning and Zheng, Yijian and Wang, Liyuan and Li, Jianguo and Liang, Xiaohui},
  title    = {Two-Stage Multi-Modal Fusion with Adaptive Alignment for Action Quality Assessment},
  journal  = IJCV,
  year     = {2026},
  volume   = {134},
  number   = {9},
  pages    = {417},
  doi      = {10.1007/s11263-026-02960-7},
  url      = {https://link.springer.com/article/10.1007/s11263-026-02960-7},
  pdf      = {https://arxiv.org/pdf/2607.07438},
  domain   = {Sports, Medical Rehabilitation},
  modality = {RGB, Optical Flow, Skeleton, Text},
  project  = {https://zhoukanglei.github.io/publications/dualalign/},
  code     = {https://github.com/Craaaaazy666/DualAlign},
  tags     = {Multi-Modal AQA, Adaptive Alignment, Missing Modality, Label Scarcity, Dataset, MM-JDM (new)},
  comment  = {DualAlign progressively aligns RGB, optical-flow, and skeleton representations before incorporating textual semantics for robust multi-modal AQA. It also introduces MM-JDM, a 1,863-sample benchmark covering 14 juvenile-dermatomyositis movement types with RGB, optical-flow, skeleton, and structured-text modalities.}
}

@inproceedings{xu2026moake,
  author    = {Xu, Huangbiao and Wu, Huanqi and Ke, Xiao and Cai, Jiaxin and Wu, Junyi and Xu, Jinglin},
  title     = {MoAKE: Toward Unified All-in-One Action Quality Assessment via Mixture of Action Knowledge Experts},
  booktitle = ECCV,
  year      = {2026},
  pdf       = {https://arxiv.org/pdf/2607.19826},
  domain    = {Sports},
  modality  = {RGB},
  code   = {https://github.com/XuHuangbiao/MoAKE},
  tags      = {All-in-One AQA, Zero-Shot AQA, Few-Shot AQA, Mixture of Experts},
  comment   = {This work studies all-in-one AQA for heterogeneous actions and proposes MoAKE, which dynamically aggregates complementary action-knowledge experts equipped with segment-aware prototypes and adaptive intra- and inter-segment relationship modeling. It also establishes all-in-one and zero/few-shot benchmarks across long- and short-term AQA datasets.}
}

@article{ghosh2026skillnet,
  title     = {SkillNet: Human Actions Assessment via Human-AI Collaboration},
