@article{chen2026interaction,
  title    = {Interaction-aware representation learning for action quality assessment in freestyle skiing big air},
  author   = {Chen, Shiyue and Liu, Yanchao and Wang, Ziyue and Cheng, Xina and Ikenaga, Takeshi},
  journal  = CVIU,
  year     = {2026},
  volume   = {264},
  pages    = {104634},
  domain   = {Sports},
  modality = {RGB},
  project  = {},
  tags     = {Freestyle Skiing, Human-Object Interaction, Dataset},
  comment  = {This work proposes an interaction-aware AQA framework for freestyle skiing big air that models athlete--ski coordination via instance-level appearance/position features with spatiotemporal reasoning, and introduces a training-free entropy-based sampling strategy to focus on performance-critical moments (take-off, rotation, landing); it also constructs a big air dataset with frame-level athlete/ski bounding boxes and metadata.}
}

