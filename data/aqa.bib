  tags      = {Multi-Modal AQA, Multi-View, Curriculum Learning, Dataset, LucidAction (new)},
  comment   = {This work introduces LucidAction, a curriculum-learning-structured AQA dataset with a three-tier hierarchy (sport event / curriculum level / action) across 8 sports events and 4 difficulty levels. Data source: mocap capture setup. Annotations: coarse-grained action score (S) + progress-aware penalty-based score annotation (PS) by professional gymnasts. Modalities: video (V) + pose (P), with multi-view RGB and 2D/3D pose sequences (multi-view MoCap capture and triangulation). Scale: 6702 samples, 259 actions, 8 views; data and code planned for open release.}
}

@inproceedings{zhou2024magr,
  author    = {Zhou, Kanglei and Wang, Liyuan and Zhang, Xingxing and Shum, Hubert P. H. and Li, Frederick W. B. and Li, Jianguo and Liang, Xiaohui},
  title     = {MAGR: Manifold-Aligned Graph Regularization for Continual Action Quality Assessment},
  booktitle = ECCV,
  year      = {2024},
