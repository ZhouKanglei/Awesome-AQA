  tags      = {Continual AQA, Benchmark},
  comment   = {This work introduces continual AQA, where a model learns to assess new action categories over time without forgetting previous ones. It proposes MAGR, which uses manifold-aligned graph regularization to preserve knowledge of prior actions while adapting to new ones, achieving strong results on several new continual AQA benchmark built from MTL-AQA and FineDiving datasets. Its following work is \cite{zhou2025continual}.}
}

@inproceedings{an2024multistage,
  author    = {An, Qi and Qi, Mengshi and Ma, Huadong},
  title     = {Multi-Stage Contrastive Regression for Action Quality Assessment},
  booktitle = ICASSP,
  year      = {2024},
  pages     = {4110--4114},
  pdf       = {https://arxiv.org/abs/2401.02841},
  domain    = {Sports},
  modality  = {RGB},
