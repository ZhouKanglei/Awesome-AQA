@article{li2026pidnet,
  title    = {PIDNet: Progressive Implicit Decouple Network for Multimodal Action Quality Assessment},
  author   = {Li, Qiqi and Wang, Pengfei and Zheng, Nenggan},
  journal  = {arXiv preprint arXiv:2605.08945},
  year     = {2026},
  pdf      = {https://arxiv.org/pdf/2605.08945},
  domain   = {Sports},
  modality = {RGB, Optical Flow, Audio},
  project  = {},
  tags     = {Multi-Modal AQA},
  comment  = {This work proposes PIDNet, a three-stage progressive fusion network for multimodal AQA that decouples and fuses modality-specific, complementary, and global quality cues via the iMambaWave module (Bi-Mamba + wavelet-transform branches with gated aggregation) and Group3M blocks with modality complementary attention; experiments on Rhythmic Gymnastics and Fis-V show competitive correlation and favorable error control.}
}

@article{gedamu2026vlc,
  title    = {Vision-Language Collaborative Representation Learning for Action Quality Assessment},
